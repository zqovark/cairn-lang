fn fibonacci(n: int) -> int {
    let previous: int = 0;
    let current: int = 1;
    let i: int = 0;
    while i < n {
        let next: int = previous + current;
        previous = current;
        current = next;
        i = i + 1;
    }
    return previous;
}
fn main() -> int {
    let results: int[10];
    let i: int = 0;
    while i < 10 {
        results[i] = fibonacci(i);
        print(results[i]);
        i = i + 1;
    }
    return 0;
}
