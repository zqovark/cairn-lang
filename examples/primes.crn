fn main() -> int {
    let n: int = 2;
    while n < 50 {
        let prime: bool = true;
        let divisor: int = 2;
        while divisor * divisor <= n {
            if n % divisor == 0 { prime = false; break; }
            divisor = divisor + 1;
        }
        if prime { print(n); }
        n = n + 1;
    }
    return 0;
}
