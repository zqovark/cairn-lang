fn main() -> int {
    let values: int[5];
    values[0] = 9; values[1] = 3; values[2] = 8;
    values[3] = 1; values[4] = 5;
    let i: int = 0;
    while i < 5 {
        let j: int = 0;
        while j < 4 - i {
            if values[j] > values[j + 1] {
                let temporary: int = values[j];
                values[j] = values[j + 1];
                values[j + 1] = temporary;
            }
            j = j + 1;
        }
        i = i + 1;
    }
    i = 0;
    while i < 5 { print(values[i]); i = i + 1; }
    return 0;
}
