fn main() -> int {
    let values: int[5];
    values[0] = 9; values[1] = 3; values[2] = 8;
    values[3] = 1; values[4] = 5;
    let i: int = 0;
    while i < 5 {
        let smallest: int = i;
        let j: int = i + 1;
        while j < 5 {
            if values[j] < values[smallest] { smallest = j; }
            j = j + 1;
        }
        let temporary: int = values[i];
        values[i] = values[smallest];
        values[smallest] = temporary;
        i = i + 1;
    }
    i = 0;
    while i < 5 { print(values[i]); i = i + 1; }
    return 0;
}
